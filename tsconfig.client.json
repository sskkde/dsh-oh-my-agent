{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "declaration": false,
    "outDir": ".build-client",
    "rootDir": "src/client",
    "types": [],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/client/index.ts", "src/client/react.d.ts"]
}
